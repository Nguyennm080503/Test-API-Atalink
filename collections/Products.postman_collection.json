	"item": [
		{
			"name": "List products",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let jsonData = pm.response.json();\r",
							"// 1. Check status code\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    try{\r",
							"        pm.response.to.have.status(200);\r",
							"    }catch(error){\r",
							"        console.log(error);\r",
							"        throw new Error(\"Fail!\");\r",
							"    }\r",
							"});\r",
							"\r",
							"// 2. Check response time\r",
							"pm.test(\"Response time is less than 3000ms\", function () {\r",
							"    try{\r",
							"        pm.expect(pm.response.responseTime).to.be.below(3000);\r",
							"    }catch(error){\r",
							"        console.log(error);\r",
							"        throw new Error(\"Fail!\");\r",
							"    }\r",
							"});\r",
							"\r",
							"// 3. Check response is not empty\r",
							"pm.test(\"Response body is not empty\", function () {\r",
							"    try{\r",
							"        pm.expect(jsonData).to.not.be.null;\r",
							"    }catch(error){\r",
							"        console.log(error);\r",
							"        throw new Error(\"Fail!\");\r",
							"    }\r",
							"});\r",
							"\r",
							"// 4. Check data exists\r",
							"pm.test(\"Response has data\", function () {\r",
							"    try{\r",
							"        pm.expect(jsonData).to.have.property(\"data\");\r",
							"    }catch(error){\r",
							"        console.log(error);\r",
							"        throw new Error(\"Fail!\");\r",
							"    }\r",
							"});\r",
							"\r",
							"// 5. Check data is an array\r",
							"pm.test(\"Data has max 32 products / page\", function () {\r",
							"    try{\r",
							"        pm.expect(jsonData.data).to.have.property(\"data\").length <= 32;\r",
							"    }catch(error){\r",
							"        console.log(error);\r",
							"        throw new Error(\"Fail!\");\r",
							"    }\r",
							"});\r",
							"\r",
							"\r",
							"// 6. Validate sorting (desc - optional check)\r",
							"pm.test(\"Data is sorted descending by updated date\", function () {\r",
							"    try{\r",
							"    let dates = jsonData.data.data.map(item => new Date(item.updatedAt).getTime());\r",
							"\r",
							"    let sorted = [...dates].sort((a, b) => b - a);\r",
							"\r",
							"    pm.expect(dates).to.eql(sorted);\r",
							"    }catch(error){\r",
							"        console.log(error);\r",
							"        throw new Error(\"Fail!\")\r",
							"    }\r",
							"});\r",
							"\r",
							"//7. Validate any duplicate products\r",
							"pm.test(\"No products are duplicated.\", function() {\r",
							"    try{\r",
							"        let products = jsonData.data.data;\r",
							"\r",
							"        let seen = new Set();\r",
							"        let duplicates = [];\r",
							"\r",
							"        products.forEach(p => {\r",
							"            let id = p.masterProductId;\r",
							"            let name = p.name;\r",
							"\r",
							"            if (!id || !name) return;\r",
							"\r",
							"            let key = `${id}-${name}`;\r",
							"\r",
							"            if (seen.has(key)) {\r",
							"                duplicates.push({ id, name });\r",
							"            } else {\r",
							"                seen.add(key);\r",
							"            }\r",
							"        });\r",
							"\r",
							"        pm.expect(duplicates.length).to.eql(0);\r",
							"\r",
							"    }catch(error){\r",
							"        console.log(\"Case 7 : \" + error);\r",
							"        throw new Error(\"Fail!\");\r",
							"    }\r",
							"});\r",
							"\r",
							"\r",
							"//8. Validate products with priceTo-priceFrom\r",
							"pm.test(\"Get data between priceFrom and priceTo\", function () {\r",
							"    let priceFrom = Number(pm.request.url.query.get(\"priceFrom\"));\r",
							"    let priceTo = Number(pm.request.url.query.get(\"priceTo\"));\r",
							"\r",
							"    let invalid = jsonData.data.data.filter(p =>\r",
							"        p.highestPrice <= priceFrom && p.highestPrice >= priceTo\r",
							"    );\r",
							"    pm.expect(invalid.length).to.eql(0);\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
